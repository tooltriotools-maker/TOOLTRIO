{
  "name": "tooltrio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/clean-next-cache.mjs && next dev",
    "build": "node -e \"const fs=require('fs');try{fs.rmSync('.next',{recursive:true,force:true})}catch(e){}\" && next build",
    "start": "next start",
    "lint": "next lint",
    "dev:safe": "node -e \"const fs=require('fs');try{fs.rmSync('.next',{recursive:true,force:true})}catch(e){}\" && next build && next start",
    "typecheck": "tsc --noEmit",
    "verify:build": "npm run verify:config && npm run p0:dependency:check && npm run catalog:check && npm run verify:registry && npm run typecheck && npm run llms:generate && npm run build",
    "verify:config": "node scripts/check-build-safety.mjs",
    "catalog:generate": "node scripts/generate-catalog.mjs && node scripts/generate-blog-catalog.mjs",
    "catalog:check": "node scripts/check-catalog.mjs && node scripts/check-blog-catalog.mjs",
    "llms:generate": "node scripts/generate-llms.mjs",
    "prebuild": "npm run p0:dependency:check && npm run catalog:check && npm run source:syntax:audit && npm run object:duplicates:audit && npm run index:type:audit && npm run llms:generate && npm run check:calculator-result-props && npm run check:calculator-result-props:all && npm run check:structured-data-props && npm run check:chart-data-props",
    "registry:check": "node scripts/check-master-registry.mjs",
    "metadata:generate": "node scripts/generate-tool-metadata.mjs",
    "metadata:check": "node scripts/check-tool-metadata.mjs",
    "verify:registry": "npm run registry:check && npm run metadata:check && npm run regional:audit && npm run content:duplication:check && npm run content:faq:check",
    "regional:audit": "node scripts/audit-regional-content.mjs",
    "content:duplication:check": "node scripts/audit-content-duplication.mjs",
    "content:faq:check": "node scripts/audit-faq-content.mjs",
    "content:faq:cleanup": "node scripts/remove-generic-faqs.mjs",
    "related:check": "node scripts/check-related-tools.mjs",
    "p0:dependency:check": "node scripts/p0-dependency-diagnostic.mjs",
    "production:config:check": "node scripts/audit-production-config.mjs",
    "check:structured-data-props": "node scripts/check-structured-data-props.mjs",
    "check:chart-data-props": "node scripts/check-chart-data-properties.mjs",
    "check:calculator-result-props": "node scripts/check-calculator-result-props.mjs",
    "blog:catalog:check": "node scripts/check-blog-catalog.mjs",
    "blog:metadata:normalize": "node scripts/normalize-blog-metadata.mjs",
    "blog:verify": "npm run blog:catalog:check",
    "formula:safety:audit": "node scripts/audit-calculation-functions.mjs",
    "source:syntax:audit": "node scripts/audit-source-syntax.mjs",
    "formula:signature:audit": "node scripts/audit-calculation-signatures.mjs",
    "check:calculator-result-props:all": "node scripts/check-calculator-result-props-all.mjs",
    "object:duplicates:audit": "node scripts/audit-ts-object-duplicates.mjs",
    "seo:shape:audit": "node scripts/audit-seo-content-shapes.mjs",
    "seo:content-props:audit": "node scripts/audit-seo-content-props.mjs",
    "index:type:audit": "node scripts/audit-dynamic-index-types.mjs",
    "dev:turbo": "node scripts/clean-next-cache.mjs && next dev --turbo"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "html2canvas": "^1.4.1",
    "jspdf": "^2.5.1",
    "leaflet": "^1.9.4",
    "lucide-react": "0.460.0",
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-leaflet": "^4.2.1",
    "recharts": "2.15.4",
    "tailwind-merge": "2.6.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.35",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.3"
  },
  "engines": {
    "node": ">=18.17.0"
  }
}
